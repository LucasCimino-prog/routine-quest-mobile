<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginBottom="75dp">

        <!-- CABEÇALHO DA CÂMARA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CÂMARA"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:fontFamily="serif"
            android:gravity="center"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pactos, conta e integrações"
            android:textSize="14sp"
            android:textColor="@color/text_hint"
            android:gravity="center"
            android:layout_marginBottom="32dp"/>

        <!-- CARD DO STRAVA (Para o seu TCC) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_missao_pergaminho"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PACTO COM STRAVA"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aguardando sincronização de treinos..."
                android:textSize="12sp"
                android:textColor="@color/text_hint"
                android:layout_marginBottom="16dp"/>

            <!-- Botão de Sair/Romper Pacto antigo -->
            <TextView
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:text="ROMPER PACTO (SAIR)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:background="@drawable/bg_botao_excluir"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- OPÇÕES DO AVENTUREIRO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conta do aventureiro"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:paddingVertical="12dp"
            android:layout_marginBottom="4dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/background_card_light" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notificações"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:paddingVertical="12dp"
            android:layout_marginBottom="4dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/background_card_light" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Routine Quest Tomo - v1.0"
            android:textSize="16sp"
            android:textColor="@color/text_hint"
            android:paddingVertical="12dp"/>

    </LinearLayout>

    <!-- NAVBAR MODULAR -->
    <include
        android:id="@+id/nav_bar"
        layout="@layout/nav_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>

</RelativeLayout>
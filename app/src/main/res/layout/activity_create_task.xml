<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_dark"
    android:padding="24dp">

    <!-- HEADER: Título e Botão Fechar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FORJAR NOVA MISSÃO"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:fontFamily="serif"
            android:layout_centerVertical="true"
            android:drawablePadding="12dp"/>

        <!-- Botão de Fechar (X) -->
        <TextView
            android:id="@+id/btnSairCriarMissao"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="✕"
            android:textColor="@color/text_hint"
            android:textSize="18sp"
            android:gravity="center"
            android:background="@drawable/bg_input_arredondado"
            android:layout_alignParentEnd="true"
            android:clickable="true"
            android:focusable="true"/>
    </RelativeLayout>

    <!-- NOME DA MISSÃO -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MISSÃO"
        android:textColor="@color/colorPrimary"
        android:textStyle="bold"
        android:textSize="12sp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etTaskName"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="Ex.: Beber 2L de água"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:background="@drawable/bg_input_arredondado"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:inputType="text"
        android:singleLine="true"
        android:layout_marginBottom="20dp"/>

    <!-- BLOCO LADO A LADO: HORÁRIO E XP -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:layout_marginBottom="20dp">

        <!-- HORÁRIO -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HORÁRIO"
                android:textColor="@color/colorPrimary"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etTaskTime"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="12:00"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:background="@drawable/bg_input_arredondado"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:focusable="false"
                android:clickable="true"
                android:drawableEnd="@android:drawable/ic_menu_recent_history"/>
        </LinearLayout>

        <!-- XP -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RECOMPENSA (XP)"
                android:textColor="@color/colorPrimary"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etTaskXp"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Ex: 50"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:background="@drawable/bg_input_arredondado"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="number"
                android:singleLine="true"/>
        </LinearLayout>
    </LinearLayout>

    <!-- DESCRIÇÃO E DURAÇÃO (Ocultos no protótipo, mas necessários para a sua API) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <EditText
            android:id="@+id/etTaskDuration"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:hint="Duração (min)"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:background="@drawable/bg_input_arredondado"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="number"
            android:singleLine="true"/>

        <EditText
            android:id="@+id/etTaskDesc"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1.5"
            android:layout_marginStart="8dp"
            android:hint="Descrição breve..."
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:background="@drawable/bg_input_arredondado"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="text"
            android:singleLine="true"/>
    </LinearLayout>

    <!-- ATRIBUTO TREINADO -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ATRIBUTO TREINADO"
        android:textColor="@color/colorPrimary"
        android:textStyle="bold"
        android:textSize="12sp"
        android:layout_marginBottom="8dp"/>

    <!-- Os 4 Atributos Quadrados -->
    <RadioGroup
        android:id="@+id/rgAttributes"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:layout_marginBottom="32dp">

        <RadioButton
            android:id="@+id/rbIntelligence"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="INT"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:button="@null"
            android:background="@drawable/bg_atributo_selector"
            android:layout_marginEnd="4dp"/>

        <RadioButton
            android:id="@+id/rbStrength"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="FOR"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:button="@null"
            android:background="@drawable/bg_atributo_selector"
            android:layout_marginEnd="4dp"
            android:layout_marginStart="4dp"/>

        <RadioButton
            android:id="@+id/rbAgility"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="AGI"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:button="@null"
            android:background="@drawable/bg_atributo_selector"
            android:layout_marginEnd="4dp"
            android:layout_marginStart="4dp"/>

        <RadioButton
            android:id="@+id/rbResistance"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="RES"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:button="@null"
            android:background="@drawable/bg_atributo_selector"
            android:layout_marginStart="4dp"/>
    </RadioGroup>

    <!-- Espaço flexível para empurrar o botão final para baixo -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- BOTÃO ADICIONAR -->
    <TextView
        android:id="@+id/btnSaveTask"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="ADICIONAR À JORNADA"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:background="@drawable/bg_botao_primario"
        android:clickable="true"
        android:focusable="true"/>

</LinearLayout>
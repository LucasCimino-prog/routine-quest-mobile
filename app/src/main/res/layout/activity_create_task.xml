<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nova Missão"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp"/>

    <EditText
        android:id="@+id/etTaskName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nome da Missão (Ex: Fazer Flexões)"
        android:inputType="text"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/etTaskDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Descrição do Treino"
        android:inputType="textMultiLine"
        android:lines="3"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/etTaskXp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Recompensa de XP (Ex: 50)"
        android:inputType="number"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/etTaskDuration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Duração em Minutos (Ex: 15)"
        android:inputType="number"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Qual atributo esta missão treina?"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <RadioGroup
        android:id="@+id/rgAttributes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <RadioButton
            android:id="@+id/rbIntelligence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inteligência"
            android:layout_weight="1"/>

        <RadioButton
            android:id="@+id/rbAgility"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Agilidade"
            android:layout_weight="1"/>
    </RadioGroup>

    <Button
        android:id="@+id/btnSaveTask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Salvar Missão"
        android:textSize="18sp"
        android:padding="12dp"
        android:backgroundTint="#4CAF50"
        android:textColor="@android:color/white"/>

</LinearLayout>
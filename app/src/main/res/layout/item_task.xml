<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@drawable/bg_missao_arredondada"
        android:clipChildren="false"
        android:clipToPadding="false">

        <TextView
            android:id="@+id/tvTaskTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:text="Nome da Tarefa (+ 50 XP)"/>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/ivStarSmokeLeft"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_estrela_xp"
                android:alpha="0" />

            <ImageView
                android:id="@+id/ivStarSmokeCenter"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_estrela_xp"
                android:alpha="0" />

            <ImageView
                android:id="@+id/ivStarSmokeRight"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_estrela_xp"
                android:alpha="0" />

            <FrameLayout
                android:id="@+id/botaoHoldToComplete"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="@drawable/bg_botao_concluir"
                android:clipToOutline="true"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:id="@+id/viewFill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#FFD700"
                    android:scaleY="0"
                    android:transformPivotY="45dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="✓"
                    android:textSize="20sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:elevation="2dp"/>
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/botaoDeleteTask"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:text="✕"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:background="@drawable/bg_botao_excluir"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

</RelativeLayout>